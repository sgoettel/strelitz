---
pagination:
  data: pages
  size: 1
  alias: pageNumber
permalink: "/scan/{{ pageNumber }}/"
title: "Scan {{ pageNumber }}"
---
{% set assets = pageNumber | scanAssets %}
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Scan {{ assets.pageNumber }} | Friedhofsregister Strelitz</title>
  <link rel="stylesheet" href="{{ '/assets/styles.css' | url }}">
  <link rel="icon" href="{{ '/favicon.ico' | url }}">
</head>
<body>
  <header class="site-header" data-pagefind-ignore>
    <div class="container header-inner">
      <div class="brand"><a href="{{ '/' | url }}">Friedhofsregister Strelitz</a></div>
      <nav class="site-nav">
        <a href="{{ '/entries/' | url }}">Einträge</a>
        <a href="{{ '/search/' | url }}">Suche</a>
        <a href="{{ '/scan/' | url }}">Scans</a>
        <a href="{{ '/downloads/' | url }}">Daten</a>
      </nav>
    </div>
  </header>
  <main class="site-main container" data-pagefind-body>
    <section class="section scan-viewer">
      <h1>OpenSeadragon Scan</h1>
      <p class="meta">Seite {{ assets.pageNumber }} &middot; Bild {{ assets.imageNumber }}</p>
      <div class="osd-controls">
        <button id="zoom-in">Zoom +</button>
        <button id="zoom-out">Zoom -</button>
        <button id="reset">Reset</button>
        <a class="button secondary" id="open-original" target="_blank" rel="noopener">Bild in neuem Tab</a>
      </div>
      <div
        id="osd-container"
        aria-label="Scan Viewer"
        data-image-url="{{ assets.imageUrl | url }}"
        data-thumb-url="{% if assets.thumbUrl %}{{ assets.thumbUrl | url }}{% endif %}"
        data-image-number="{{ assets.imageNumber }}"
      ></div>
      <p id="osd-error" class="osd-error" hidden>Der Scan konnte nicht geladen werden.</p>
      <div class="section">
        <h2>Thumbnail (optional)</h2>
        <img id="thumb" class="thumb" alt="Thumbnail" loading="lazy" aria-hidden="true">
        <p class="meta">Falls ein Thumbnail fehlt oder abweicht, blendet die Seite es automatisch aus.</p>
      </div>
    </section>
  </main>
  <footer class="site-footer" data-pagefind-ignore>
    <div class="container">
    </div>
  </footer>
  <script src="{{ '/assets/vendor/openseadragon.min.js' | url }}"></script>
  <script>
    (function(){
      const container = document.getElementById('osd-container');
      const imageUrl = container.dataset.imageUrl;
      const imageNumber = container.dataset.imageNumber;
      const thumbUrl = container.dataset.thumbUrl;
      const errorMessage = document.getElementById('osd-error');

      const viewer = OpenSeadragon({
        id: 'osd-container',
        tileSources: {
          type: 'image',
          url: imageUrl
        },
        imageAlt: `Scan ${imageNumber}`,
        prefixUrl: "{{ '/assets/vendor/openseadragon-images/' | url }}"
      });

      viewer.addHandler('open-failed', (event) => {
        const error = event?.message || event?.error || event;
        console.error('OpenSeadragon open-failed', { imageUrl, error });
        errorMessage.textContent = 'Der Scan konnte nicht geladen werden. Bitte prüfe die Bild-URL in der Konsole.';
        errorMessage.hidden = false;
      });

      document.getElementById('zoom-in').addEventListener('click', () => viewer.zoomIn());
      document.getElementById('zoom-out').addEventListener('click', () => viewer.zoomOut());
      document.getElementById('reset').addEventListener('click', () => viewer.reset());

      const originalLink = document.getElementById('open-original');
      originalLink.href = imageUrl;
      originalLink.textContent = `Bild ${imageNumber} in neuem Tab`;

      const thumb = document.getElementById('thumb');
      if (thumbUrl) {
        thumb.src = thumbUrl;
        thumb.addEventListener('error', () => { thumb.style.display = 'none'; });
      } else {
        thumb.style.display = 'none';
      }
    })();
  </script>
</body>
</html>
